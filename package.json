{
  "name": "@aaroncadillac/crudify-mongo",
  "version": "3.1.1",
  "description": "A secure-by-default CRUD generator for Fastify and Mongoose, with hooks, scoping and a built-in query sanitizer",
  "keywords": [
    "fastify",
    "mongoose",
    "mongodb",
    "crud",
    "rest",
    "sanitizer",
    "plugin"
  ],
  "main": "./crudify.js",
  "exports": {
    ".": "./crudify.js",
    "./sanitizer": "./sanitizer.js",
    "./package.json": "./package.json"
  },
  "files": [
    "crudify.js",
    "sanitizer.js",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaroncadillac/crudify-mongo.git"
  },
  "author": "aaroncadillac",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:local": "MONGOMS_SYSTEM_BINARY=$(command -v mongod) node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "bench": "node bench/run.js"
  },
  "license": "MPL-2.0",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "resolutions": {
    "fastify/light-my-request/cookie": "^1.1.1"
  },
  "peerDependencies": {
    "fastify": "^4.0.0 || ^5.0.0",
    "mongoose": "^8.0.0",
    "mongoose-paginate-v2": "^1.8.0"
  },
  "peerDependenciesMeta": {
    "mongoose-paginate-v2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fastify/auth": "^5.0.0",
    "@shelf/jest-mongodb": "^4.3.2",
    "fastify": "^5.0.0",
    "fastify4": "npm:fastify@^4.29.0",
    "jest": "^29.7.0",
    "mongoose": "^8.17.0",
    "mongoose-paginate-v2": "^1.8.2"
  }
}
